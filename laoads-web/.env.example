# Copy thành .env.local (gitignored) rồi chỉnh.

# Chế độ API:
#   real   — gọi BE thật toàn bộ
#   hybrid — (mặc định) BE thật cho auth/workspace/thành viên/bảng giá/nhật ký/quản trị;
#            MSW mock cho dashboard/chiến dịch/tệp KH/phê duyệt/cài đặt gửi tin (BE đợt 1 chưa có)
#   mock   — mock toàn bộ, không cần BE (demo UI). `npm run dev:mock` tự bật chế độ này.
VITE_API_MODE=hybrid

# Base URL của API. Bỏ trống → dùng /api/v1 cùng origin (Vite proxy ở dev, nginx ở prod).
# VITE_API_BASE_URL=http://localhost:8095/api/v1

# Đích proxy của Vite dev server cho /api
# VITE_PROXY_TARGET=http://localhost:8095
