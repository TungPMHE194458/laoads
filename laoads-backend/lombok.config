# Stop bubbling — root config, do not look in parent dirs.
config.stopBubbling = true

# Copy @Qualifier (and others) từ field xuống constructor parameter
# để @RequiredArgsConstructor + @Qualifier hoạt động.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += jakarta.annotation.Nonnull
lombok.copyableAnnotations += jakarta.annotation.Nullable
