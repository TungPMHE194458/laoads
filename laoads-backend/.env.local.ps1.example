# Copy thành .env.local.ps1 (gitignored) rồi điền. start-dev.ps1 tự nạp file này.
# Không đặt biến nào → default của application-dev.yml: Oracle XE LOCAL (../docker-compose.dev.yml)
#   jdbc:oracle:thin:@//localhost:1521/XE · user LAOADS / laoads · schema LAOADS · JWT secret dev.

# $env:LAOADS_JWT_SECRET  = "<chuỗi ngẫu nhiên >= 32 byte>"
# $env:SERVER_PORT        = "8095"

# Mock data dev (DevMockDataSeeder: 20 user, 4 workspace, bảng giá, ~100 dòng nhật ký) — mặc định bật
# $env:LAOADS_DEV_MOCK_DATA = "false"

# DB local ở cổng khác (khi đặt LAOADS_DEV_DB_PORT cho docker-compose.dev.yml)
# $env:LAOADS_DB_URL      = "jdbc:oracle:thin:@//localhost:1522/XE"

# ⚠ KHÔNG khuyến nghị — trỏ dev sang DB dùng chung (BOC): dev sẽ chạy DevDataSeeder (tài khoản demo mật khẩu yếu)
# và flyway.repair() trên DB đó. DevDatabaseGuard chặn start nếu không có LAOADS_DEV_ALLOW_REMOTE_DB=true.
# $env:LAOADS_DB_URL               = "jdbc:oracle:thin:@//<host>:1521/<service>"
# $env:LAOADS_DB_USERNAME          = "<user>"
# $env:LAOADS_DB_PASSWORD          = "<mật khẩu>"
# $env:LAOADS_DB_SCHEMA            = "<schema>"
# $env:LAOADS_DEV_ALLOW_REMOTE_DB  = "true"

# VSA (CAS 2.0) — tắt mặc định
# $env:LAOADS_VSA_ENABLED     = "true"
# $env:LAOADS_VSA_CAS_URL     = "https://vsa.example.la/cas"
# $env:LAOADS_VSA_SERVICE_URL = "http://localhost:5173/auth/vsa/callback"
